# CourseCraft Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Django secret key — generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Google Gemini API key for AI course generation
GEMINI_API_KEY=

# YouTube Data API v3 key for video search
YOUTUBE_API_KEY=

# PostgreSQL connection string (production only)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Comma-separated list of allowed CORS origins (production only)
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Set to any value to enable production mode (disables DEBUG)
# RENDER=true
